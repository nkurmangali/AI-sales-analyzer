# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Deepgram (транскрипция с таймкодами) — https://console.deepgram.com
DEEPGRAM_API_KEY=
# Необязательно: модель и язык распознавания
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=ru

# Vercel Blob — подставляется автоматически, когда Blob store подключён к проекту
BLOB_READ_WRITE_TOKEN=

# Необязательно: пароль на приложение (Basic Auth). Пусто — без пароля.
APP_PASSWORD=
